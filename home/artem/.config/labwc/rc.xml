<?xml version="1.0"?>

<!--
  This is a very simple config file with many options missing. For a complete
  set of options with comments, see docs/rc.xml.all
-->

<labwc_config>

  <desktops number="3" />

  <keyboard>
    <default />
    <!-- 
      Define a key binding in the format modifier-key, where supported modifiers are:
       -   S (shift)
       -   C (control)
       -   A or Mod1 (alt)
       -   H or Mod3 (hyper)
       -   W or Mod4 (super / logo)
       -   M or Mod5 (meta)
    -->

    <!-- make step smaller for low brightness -->
    <keybind key="XF86_MonBrightnessUp">
      <action name="Execute" command="brightnessctl --exponent set +7%" />
    </keybind>
    <keybind key="XF86_MonBrightnessDown">
      <action name="Execute" command="brightnessctl --exponent set 7%-" />
    </keybind>

    <!-- adjust volume with wpctl not amixer, small step when SHIFT held -->
    <keybind key="S-XF86_AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-" />
    </keybind>
    <keybind key="S-XF86_AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume --limit 2.0 @DEFAULT_AUDIO_SINK@ 2%+" />
    </keybind>
    <!-- adjust volume with wpctl not amixer, normally large step -->
    <keybind key="XF86_AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%-" />
    </keybind>
    <keybind key="XF86_AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume --limit 2.0 @DEFAULT_AUDIO_SINK@ 10%+" />
    </keybind>
    <!-- adjust volume with wpctl not amixer -->
    <keybind key="XF86_AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="XF86_AudioMicMute">
      <action name="Execute" command="sh -c 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ; echo 1 > /sys/devices/virtual/input/input23/input23::mute/brightness'" />
    </keybind>

    <keybind key="XF86_Calculator">
      <action name="Execute" command="sh -c 'x=/sys/class/leds/platform::kbd_backlight/brightness; if [[ $( cat $x ) = 1 ]] then echo 0 > $x ; else echo 1 > $x ; fi'" />
    </keybind>

    <!-- launch root menu that allows to toggle trackpad/keyboard on/off -->
    <keybind key="XF86_Favorites">
      <action name="ShowMenu" menu="root-menu" />
    </keybind>


    <!-- launch runner menu -->
    <keybind key="A-r">
      <action name="Execute" command="fuzzel" />
    </keybind>

    <!-- launch terminal tab/window -->
    <keybind key="A-t">
      <!-- see: https://sw.kovidgoyal.net/kitty/remote-control/ -->
      <action name="Execute" command="~/.config/labwc/kitty-global-launcher.sh" />
    </keybind>

    <!-- launch bluetooth manager -->
    <keybind key="A-b">
      <action name="Execute" command="blueman-manager" />
    </keybind>

    <!-- launch clipboard history -->
    <keybind key="A-h">
      <action name="Execute" command="sh -c 'cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'" />
    </keybind>

    <!-- launch screenshot -->
    <keybind key="A-f">
      <action name="Execute" command="sh -c 'slurp | grim -g - - | swappy -f -'" />
    </keybind>

    <!-- Go to workspace -->
    <keybind key="A-C-a">
      <action name="GoToDesktop" to="1" />
      <action name="Execute" command="sh -c 'echo 1 > /tmp/labwc-current-workspace'" />
    </keybind>
    <keybind key="A-C-s">
      <action name="GoToDesktop" to="2" />
      <action name="Execute" command="sh -c 'echo 2 > /tmp/labwc-current-workspace'" />
    </keybind>
    <keybind key="A-C-x">
      <action name="GoToDesktop" to="3" />
      <action name="Execute" command="sh -c 'echo 3 > /tmp/labwc-current-workspace'" />
    </keybind>

    <!-- Steal (send and go) to workspace -->
    <keybind key="A-S-a">
      <action name="SendToDesktop" to="1" />
      <action name="Execute" command="sh -c 'echo 1 > /tmp/labwc-current-workspace'" />
    </keybind>
    <keybind key="A-S-s">
      <action name="SendToDesktop" to="2" />
      <action name="Execute" command="sh -c 'echo 2 > /tmp/labwc-current-workspace'" />
    </keybind>
    <keybind key="A-S-x">
      <action name="SendToDesktop" to="3" />
      <action name="Execute" command="sh -c 'echo 3 > /tmp/labwc-current-workspace'" />
    </keybind>

    <!-- Send to workspace -->
    <keybind key="A-W-a">
      <action name="SendToDesktop" to="1" follow="no" />
    </keybind>
    <keybind key="A-W-s">
      <action name="SendToDesktop" to="2" follow="no" />
    </keybind>
    <keybind key="A-W-x">
      <action name="SendToDesktop" to="3" follow="no" />
    </keybind>

  </keyboard>


  <mouse>
    <default />

    <context name="Frame">
      <mousebind button="A-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="A-S-Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>

  </mouse>


  <focus>
    <default />
    <followMouse>yes</followMouse>
    <followMouseRequiresMovement>yes</followMouseRequiresMovement>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <!--
    The *category* attribute is optional and can be set to touch, touchpad,
    non-touch, default or the name of a device. You can obtain device names by
    running *libinput list-devices* as root or member of the input group.

    Tap is set to *yes* by default. All others are left blank in order to use
    device defaults.

    All values are [yes|no] except for:
      - pointerSpeed [-1.0 to 1.0]
      - accelProfile [flat|adaptive]
      - tapButtonMap [lrm|lmr]
      - clickMethod [none|buttonAreas|clickfinger]
      - sendEventsMode [yes|no|disabledOnExternalMouse]
      - calibrationMatrix [six float values split by space]
      - scrollFactor [float]
  -->
  <libinput>
    <device category="ELAN06FA:00 04F3:3293 Touchpad">
      <naturalScroll></naturalScroll>
      <leftHanded></leftHanded>
      <pointerSpeed></pointerSpeed>
      <accelProfile></accelProfile>
      <tap>yes</tap>
      <tapButtonMap></tapButtonMap>
      <tapAndDrag></tapAndDrag>
      <dragLock></dragLock>
      <middleEmulation></middleEmulation>
      <disableWhileTyping></disableWhileTyping>
      <clickMethod></clickMethod>
      <sendEventsMode>yes</sendEventsMode>
      <calibrationMatrix></calibrationMatrix>
      <scrollFactor>1.0</scrollFactor>
    </device>
    <device category="Kensington ORBIT WIRELESS TB Mouse">
      <naturalScroll></naturalScroll>
      <leftHanded></leftHanded>
      <pointerSpeed>-0.5</pointerSpeed>
      <accelProfile>adaptive</accelProfile>
      <tap>yes</tap>
      <tapButtonMap></tapButtonMap>
      <tapAndDrag></tapAndDrag>
      <dragLock></dragLock>
      <middleEmulation></middleEmulation>
      <disableWhileTyping></disableWhileTyping>
      <clickMethod></clickMethod>
      <sendEventsMode>yes</sendEventsMode>
      <calibrationMatrix></calibrationMatrix>
      <scrollFactor>0.5</scrollFactor>
    </device>
  </libinput>

</labwc_config>
