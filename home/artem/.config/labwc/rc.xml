<?xml version="1.0"?>

<!--
  This is a very simple config file with many options missing. For a complete
  set of options with comments, see docs/rc.xml.all
-->

<labwc_config>

  <keyboard>
    <default />

    <!-- make step smaller for low brightness -->
    <keybind key="XF86_MonBrightnessUp">
      <action name="Execute" command="brightnessctl --exponent set +7%" />
    </keybind>
    <keybind key="XF86_MonBrightnessDown">
      <action name="Execute" command="brightnessctl --exponent set 7%-" />
    </keybind>

    <!-- adjust volume with wpctl not amixer -->
    <keybind key="XF86_AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
    </keybind>
    <keybind key="XF86_AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+" />
    </keybind>
    <keybind key="XF86_AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="XF86_AudioMicMute">
      <action name="Execute" command="sh -c 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ; echo 1 > /sys/devices/virtual/input/input23/input23::mute/brightness'" />
    </keybind>

    <keybind key="XF86_Calculator">
      <action name="Execute" command="sh -c 'x=/sys/class/leds/platform::kbd_backlight/brightness; if [[ $( cat $x ) = 1 ]] then echo 0 > $x ; else echo 1 > $x ; fi'" />
    </keybind>


    <!-- launch runner menu -->
    <keybind key="A-r">
      <action name="Execute" command="fuzzel" />
    </keybind>

    <!-- launch terminator tab/window -->
    <keybind key="A-t">
      <action name="Execute" command="terminator --new-tab" />
    </keybind>

    <!-- launch clipboard history -->
    <keybind key="A-h">
      <action name="Execute" command="sh -c 'cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'" />
    </keybind>

    <!-- launch screenshot -->
    <keybind key="A-s">
      <action name="Execute" command="sh -c 'slurp | grim -g - - | swappy -f -'" />
    </keybind>

  </keyboard>


  <mouse>
    <default />

    <context name="Frame">
      <mousebind button="A-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="A-S-Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>

  </mouse>


  <focus>
    <default />
    <followMouse>yes</followMouse>
    <followMouseRequiresMovement>yes</followMouseRequiresMovement>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

</labwc_config>
