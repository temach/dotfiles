<?xml version="1.0"?>

<!--
  This is a very simple config file with many options missing. For a complete
  set of options with comments, see docs/rc.xml.all
-->

<labwc_config>

<!--
  <theme>
    <name></name>
    <cornerRadius>8</cornerRadius>
    <font name="sans" size="10" />
  </theme>
-->

  <keyboard>
    <default />

    <!-- make step smaller for low brightness -->
    <keybind key="XF86_MonBrightnessUp">
      <action name="Execute" command="brightnessctl --exponent set +7%" />
    </keybind>
    <keybind key="XF86_MonBrightnessDown">
      <action name="Execute" command="brightnessctl --exponent set 7%-" />
    </keybind>

    <!-- launch runner menu -->
    <keybind key="A-r">
      <action name="Execute" command="fuzzel" />
    </keybind>

    <!-- launch clipboard history -->
    <keybind key="A-h">
      <action name="Execute" command="sh -c 'cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'" />
    </keybind>

    <!-- Remove a previously defined keybind -->
    <keybind key="W-F4">
      <action name="None" />
    </keybind>

  </keyboard>

</labwc_config>
