# get display info using: wlr-randr
#
# HDMI-A-1 "Dell Inc. DELL P2423D 82LRVP3 (HDMI-A-1)"
#   Make: Dell Inc.
#   Model: DELL P2423D
#   Serial: 82LRVP3
#
# eDP-1 "Lenovo Group Limited 0x8AB1 (eDP-1)"
#   Make: Lenovo Group Limited
#   Model: 0x8AB1
#   Serial: (null)

profile {
  output eDP-1 {
    disable
    scale 1.5 
    mode 3072x1920
    position 0,0
  }
  output HDMI-A-1 {
    scale 1.0
    mode 2560x1440
    position 0,-1440
  }
}

profile {
  output eDP-1 {
    scale 1.5 
    mode 3072x1920
    position 0,0
  }
}
